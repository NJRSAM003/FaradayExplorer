<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-faraday-model">
    <comment>Faraday Explorer Model File</comment>
    <comment xml:lang="en">Faraday depth polarisation model</comment>
    <glob pattern="*.model"/>
    <magic priority="50">
      <match type="string" offset="0" value="FARADAY" />
    </magic>
  </mime-type>
</mime-info>

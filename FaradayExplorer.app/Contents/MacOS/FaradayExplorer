#!/bin/bash
# Debug wrapper for FaradayExplorer
# Logs all invocations and arguments to help diagnose file association issues

LOG_FILE="$HOME/.FaradayExplorer.log"
{
    echo "=== FaradayExplorer wrapper invoked at $(date) ==="
    echo "Arguments: $@"
    echo "Number of args: $#"
    for arg in "$@"; do
        echo "  arg: $arg"
    done
    echo "PWD: $(pwd)"
    echo "USER: $(whoami)"
    echo "---"
} >> "$LOG_FILE" 2>&1

# Activate the faraday_explorer conda environment and run the app
eval "$(/opt/anaconda3/bin/conda shell.bash hook)"
conda activate faraday_explorer

{
    echo "Conda activated. Python info:"
    which python3
    python3 --version
    echo "---"
} >> "$LOG_FILE" 2>&1

python3 /Users/amaninjoroge/FaradayExplorer/faraday_explorer.py "$@" >> "$LOG_FILE" 2>&1

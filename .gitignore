# Large data files — do not commit
*.fits
*.FITS
*.ms
*.uvfits
# …except small bundled demo cubes
!dummy_cubes/*.fits

# Video files — splash videos are intentionally kept (app branding)
*.mp4
!splash.mp4
!splash_app.mp4
*.webm

# Output files
*.png
!splash_frame.png
!FEIcon.png
!images/*.png
FEIcon_old.png
*.pdf
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# macOS-only local helpers (Finder file-association wrappers, hardcoded /Users paths)
open-mod-file.sh

# Qt settings cache
*.ini
